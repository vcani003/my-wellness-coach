# Copy to .env.local for local development. Never commit real values.

# Local embedded Postgres (PGlite) data folder. Git-ignored.
PGLITE_DIR=.data/pglite

# Reserved for Neon (OPEN-QUESTIONS S2). Leave empty for local development.
DATABASE_URL=

# Developer-only "acting as" switch (Vero / Levi in the local demo kitchen; milestone 2).
# On by default in `npm run dev`; set to "off" to see the signed-out page. A production server
# refuses to start if this is set to anything but "off".
# DEV_ACTING_AS=off

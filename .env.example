# Names only, never values. Copy to .env.local for local development (git-ignored);
# set real values in Vercel → Project → Settings → Environment Variables.
# See docs/architecture/backend-data.md §10 "Deploying to Vercel".

# ── Database ────────────────────────────────────────────────────────────────
# Neon connection string (pooled or direct, with sslmode=require). Set = Neon; empty = local PGlite.
# Required in production.
DATABASE_URL=
# Local embedded Postgres (PGlite) folder, used only when DATABASE_URL is empty. Default .data/pglite.
PGLITE_DIR=

# ── Interim access-code gate (until email sign-in) ──────────────────────────
# Signs the session cookie. At least 32 random characters, e.g. from `openssl rand -base64 48`.
# Changing it signs everyone out. Required in production.
SESSION_SECRET=
# One code per person: vero=<code>,levi=<code>  (names are the user IDs from db:bootstrap).
# Each code at least 12 characters, no commas; e.g. from `openssl rand -hex 8`.
# Changing one person's code signs out just them. Required in production.
ACCESS_CODES=

# ── AI ──────────────────────────────────────────────────────────────────────
# fake (default: fixed answers, no AI calls) or real.
AI_MODE=
# Required when AI_MODE=real.
ANTHROPIC_API_KEY=

# ── Development only ────────────────────────────────────────────────────────
# "Acting as" switch: a user ID (e.g. tester-1 after db:seed, or vero after db:bootstrap).
# Skips the access-code gate locally. The server refuses to start in production if set.
DEV_ACTING_AS=
# For local dev with the demo kitchen (Vero + Levi): DEV_ACTING_AS=demo-vero

# ── Set by Vercel, never by hand ────────────────────────────────────────────
# VERCEL_ENV: production | preview | development. Only `preview` (staging) lets tester accounts
# sign in and creates the test kitchens on build (backend-data.md §10 "Staging").
